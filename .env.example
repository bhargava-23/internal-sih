# AquaSence AI V1 — Environment Configuration
# Copy this file to .env for local development.
# Never commit .env.
# No API key is required for the intended Open-Meteo prototype use.

APP_NAME=AquaSence AI
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173

DATABASE_URL=sqlite:///./data/aquasence.db

OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_ARCHIVE_BASE_URL=https://archive-api.open-meteo.com/v1
OPEN_METEO_TIMEOUT_SECONDS=15

DEFAULT_LATITUDE=12.9716
DEFAULT_LONGITUDE=77.5946
DEFAULT_TIMEZONE=auto

SIMULATION_SEED=42
SIMULATION_DEFAULT_SCENARIO=drying
SIMULATION_DEFAULT_DURATION_HOURS=168
SIMULATION_TIMESTEP_MINUTES=60

# Allowed scenarios:
# healthy
# drying
# rain_incoming
# high_et
# delivery_anomaly

DEFAULT_CROP=tomato
DEFAULT_GROWTH_STAGE=flowering
DEFAULT_SOIL_TEXTURE=loam
DEFAULT_ROOT_ZONE_DEPTH_M=0.60
DEFAULT_FIELD_AREA_M2=100.0
DEFAULT_IRRIGATION_EFFICIENCY=0.90

MODEL_PATH=data/models/xgboost_residual_model.json
MODEL_METADATA_PATH=data/models/xgboost_residual_model_metadata.json
ML_TARGET_HORIZON_HOURS=24
ML_RANDOM_SEED=42

DATA_DIR=data
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
SIMULATION_DATA_DIR=data/simulation
MODEL_DIR=data/models
METRICS_DIR=data/metrics

WEBSOCKET_HEARTBEAT_SECONDS=15
WEBSOCKET_RECONNECT_SECONDS=3

ALLOW_DEMO_SIMULATION=true
ALLOW_MANUAL_OVERRIDE=true
MAX_SIMULATED_VALVE_RUNTIME_MINUTES=120

# Future hardware integrations — intentionally disabled for V1:
# MQTT_BROKER_URL=
# MQTT_USERNAME=
# MQTT_PASSWORD=
# GSM_ENABLED=false
# HARDWARE_MODE=false
